+	// prevInput has been rotated by each bin's own centre frequency (over one interval), so
+	// plain interpolation blends two different rotations and skews the phase advance - the
+	// output frequency - by up to a bin.  Rotate both neighbours to the fractional position.
+	Complex getFractionalPrevInput(int channel, int lowIndex, Sample fractional) {
+		if (fractional == 0) return getFractional<&Band::prevInput>(channel, lowIndex, fractional);
+		Sample binTurn = (bandToFreq(1) - bandToFreq(0))*stft.defaultInterval()*Sample(2*M_PI);
+		Complex low = getBand<&Band::prevInput>(channel, lowIndex)*std::polar(Sample(1), fractional*binTurn);
+		Complex high = getBand<&Band::prevInput>(channel, lowIndex + 1)*std::polar(Sample(1), (fractional - 1)*binTurn);
+		return low + (high - low)*fractional;
+	}
